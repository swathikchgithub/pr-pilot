generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum RepoStatus {
  PENDING
  INDEXING
  READY
  FAILED
}

enum AuditEventType {
  QUERY
  IMPACT_ANALYSIS
}

// -----------------------------------------------------------------------------
// Models
// -----------------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  users     User[]
  apiKeys   ApiKey[]
  repos     Repo[]
  auditLogs AuditLogEntry[]

  @@map("organizations")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         OrgRole  @default(OWNER)
  orgId        String   @map("org_id")
  createdAt    DateTime @default(now()) @map("created_at")

  org       Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  auditLogs AuditLogEntry[]

  @@index([orgId])
  @@map("users")
}

model ApiKey {
  id         String    @id @default(cuid())
  orgId      String    @map("org_id")
  name       String
  keyPrefix  String    @map("key_prefix")
  keyHash    String    @unique @map("key_hash")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")

  org       Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  auditLogs AuditLogEntry[]

  @@index([orgId])
  @@map("api_keys")
}

model Repo {
  id            String     @id @default(cuid())
  orgId         String     @map("org_id")
  githubUrl     String     @map("github_url")
  defaultBranch String     @default("main") @map("default_branch")
  status        RepoStatus @default(PENDING)
  chunkCount    Int        @default(0) @map("chunk_count")
  lastIndexedAt DateTime?  @map("last_indexed_at")
  lastError     String?    @map("last_error")
  createdAt     DateTime   @default(now()) @map("created_at")

  org       Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  chunks    CodeChunk[]
  auditLogs AuditLogEntry[]

  @@unique([orgId, githubUrl])
  @@index([orgId])
  @@map("repos")
}

/// The `embedding` column is `vector(768)` (Google gemini-embedding-001, pinned to
/// 768 output dimensions). Prisma Client can't read/write pgvector columns directly, so
/// all writes and similarity queries against this table go through raw SQL —
/// see RetrievalModule / worker ingestion.
model CodeChunk {
  id         String   @id @default(cuid())
  repoId     String   @map("repo_id")
  filename   String
  startLine  Int      @map("start_line")
  endLine    Int      @map("end_line")
  content    String
  symbolKind String?  @map("symbol_kind")
  symbolName String?  @map("symbol_name")
  createdAt  DateTime @default(now()) @map("created_at")

  embedding Unsupported("vector(768)")?

  repo Repo @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@index([repoId])
  @@map("code_chunks")
}

model AuditLogEntry {
  id        String         @id @default(cuid())
  orgId     String         @map("org_id")
  repoId    String         @map("repo_id")
  apiKeyId  String?        @map("api_key_id")
  userId    String?        @map("user_id")
  eventType AuditEventType @map("event_type")
  input     String
  output    String
  citations Json           @default("[]")
  createdAt DateTime       @default(now()) @map("created_at")

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  repo   Repo         @relation(fields: [repoId], references: [id], onDelete: Cascade)
  apiKey ApiKey?      @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  user   User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([repoId])
  @@map("audit_log_entries")
}
