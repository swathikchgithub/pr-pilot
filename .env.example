# ==============================================================================
# PR-Pilot — environment variables
# Copy to .env (root, for docker-compose / scripts) and to apps/api/.env,
# apps/worker/.env, apps/web/.env.local as needed. NEVER commit real values.
# ==============================================================================

# ---- Shared infra --------------------------------------------------------
# Postgres with the `vector` extension enabled (Railway Postgres, Supabase, or local docker-compose)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pr_pilot?schema=public"

# Redis for the BullMQ ingestion queue (Railway Redis or local docker-compose)
REDIS_URL="redis://localhost:6379"

# ---- apps/api --------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Signing secret for dashboard-user JWTs. Generate with: openssl rand -hex 32
JWT_SECRET="replace-with-a-64-char-random-hex-string"
JWT_EXPIRES_IN="12h"

# Pepper mixed into API-key hashing (in addition to per-key salt). Generate with: openssl rand -hex 32
API_KEY_PEPPER="replace-with-a-64-char-random-hex-string"

# Origin(s) allowed to call the API with credentials (the web app URL)
CORS_ORIGIN="http://localhost:3000"

# Cookie domain for the dashboard session cookie. Leave blank for localhost.
COOKIE_DOMAIN=""

# ---- AI providers (shared by apps/api and apps/worker) --------------------
# https://aistudio.google.com/api-keys — used for embeddings + answer generation
GOOGLE_GENERATIVE_AI_API_KEY="your-gemini-api-key"

# https://dashboard.cohere.com/api-keys — used for cross-encoder reranking
COHERE_API_KEY="your-cohere-api-key"

# ---- apps/worker ------------------------------------------------------------
# GitHub personal access token (repo:read scope) — raises API rate limits and
# allows ingesting private repos. Optional for public repos but recommended.
GITHUB_TOKEN="your-github-token"

# ---- apps/web ---------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:4000"
